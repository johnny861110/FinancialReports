# Copy to .env and adjust. docker-compose reads this file automatically.

# --- Postgres container ---
POSTGRES_USER=financial
POSTGRES_PASSWORD=financial
POSTGRES_DB=financial
POSTGRES_PORT=5432
API_PORT=8010

# --- Application ---
# Connection used by the API, the CLI and the test suite.
# Inside compose the host is "db"; from the host machine it is localhost.
FR_DATABASE_URL=postgresql+psycopg://financial:financial@localhost:5432/financial

# Where downloaded source documents are written.
FR_OUTPUT_DIR=data/raw
